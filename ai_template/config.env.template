# ============================================================
# Universal AI Agent Template — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp config.env.template .env
#
# Then edit .env with your actual API keys and settings.
# NEVER commit .env to version control.
# .env is already in .gitignore by default.
# ============================================================

# ─── LLM BACKEND SELECTION ───────────────────────────────────
# Which LLM provider to use by default.
# Options: groq | ollama | gemini
# Can be overridden per-request via the "backend" field in POST body.
AGENT_BACKEND=groq

# ─── GROQ CONFIGURATION ──────────────────────────────────────
# Your Groq API key (single key — or use groq_key.txt for multiple).
# Get free keys at: https://console.groq.com
# The system also reads groq_key.txt (one key per line) for key rotation.
GROQ_API_KEY=gsk_PASTE_YOUR_KEY_HERE

# Which Groq model to use (default if not overridden per-request).
# Recommended options (April 2026 free tier):
#   qwen/qwen3-32b          — best reasoning quality (FundTrace default)
#   llama-3.3-70b-versatile — fast and accurate
#   mixtral-8x7b-32768      — good for long context
GROQ_MODEL=qwen/qwen3-32b

# ─── OLLAMA CONFIGURATION ────────────────────────────────────
# Only needed if using AGENT_BACKEND=ollama.
# Requires: ollama serve (running locally)
# Pull models with: ollama pull llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ─── GEMINI CONFIGURATION ────────────────────────────────────
# Only needed if using AGENT_BACKEND=gemini.
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE

# ─── SERVER CONFIGURATION ────────────────────────────────────
# Port the AI agent HTTP server listens on.
# Default: 5002 (matches FundTrace convention)
# Your frontend/Node.js should call: http://localhost:5002
AGENT_PORT=5002

# ─── DATABASE CONFIGURATION ──────────────────────────────────
# [CUSTOMIZE] Path to your SQLite database file.
# The default in db_tool.py looks for: ../server/fundtrace.db
# Set this env var to override that default path.
# Example: DB_PATH=/absolute/path/to/your/app.db
# DB_PATH=

# ─── LOGGING CONFIGURATION ───────────────────────────────────
# Log level for console output.
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── NOTES ───────────────────────────────────────────────────
# For multiple Groq API keys (recommended for sustained use):
#   Create groq_key.txt in the ai_template/ directory.
#   Add one key per line (no quotes, no spaces):
#     gsk_key_one_here
#     gsk_key_two_here
#     gsk_key_three_here
#   The system loads all keys at startup and rotates randomly.
#   If one key hits a rate limit, it automatically tries another.
#
# Key masking:
#   The /health endpoint shows keys as: key#1: gsk_abc1...xyz9
#   Full keys are never logged or displayed.
